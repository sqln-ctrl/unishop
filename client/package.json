{
  "name": "unishop-client",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "DATABASE_URL=file:./prisma/dev.db npm run db:deploy && next build",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:deploy": "node server/scripts/prepare-database.js && prisma migrate deploy --config prisma.config.ts",
    "db:studio": "prisma studio --config prisma.config.ts",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "next": "^16.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "streamifier": "^0.1.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prisma": "7.10.0",
    "tailwindcss": "^3.4.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
