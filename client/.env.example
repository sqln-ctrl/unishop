# Local SQLite database. Vercel does not provide persistent SQLite storage.
DATABASE_URL="file:./prisma/dev.db"

# Long, private signing key for JWT sessions.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# Optional for local development or a separately hosted frontend.
CLIENT_URL=http://localhost:3000

# Required only for listing photo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional only when the browser must call a separately deployed API.
# NEXT_PUBLIC_API_URL=https://api.example.com/api
