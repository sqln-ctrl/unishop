# Supabase Dashboard > Connect: copy the exact pooler host for your project.
# Runtime: Transaction pooler (port 6543), suitable for Vercel.
# Replace placeholders and URL-encode special characters in the database password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"

# Prisma CLI: Session pooler (port 5432), also works on IPv4 networks.
# Alternatively use the direct database URL if your network supports IPv6.
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Long, private signing key for JWT sessions.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# First admin only: use an unused email and a random password (12+ characters).
# Leave both blank to skip setup. Dashboard changes are stored in the database;
# these bootstrap values never overwrite an existing admin's credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="UniShop Admin"

# Optional for local development or a separately hosted frontend.
CLIENT_URL=http://localhost:3000

# Required only for listing photo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional only when the browser must call a separately deployed API.
# NEXT_PUBLIC_API_URL=https://api.example.com/api
