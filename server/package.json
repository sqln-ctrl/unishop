{
  "name": "unishop-server",
  "version": "1.0.0",
  "description": "UniShop backend API - university student marketplace",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/prepare-database.js && prisma migrate dev",
    "db:deploy": "node scripts/prepare-database.js && prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "streamifier": "^0.1.1",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-better-sqlite3": "7.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "7.10.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
